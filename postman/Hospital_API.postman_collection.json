{
  "info": {
    "name": "Hospital Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.collectionVariables.set('today', now.toISOString().slice(0,10));",
          "const future = new Date(now.getTime()+7*24*60*60*1000);",
          "pm.collectionVariables.set('futureAppointment', future.toISOString().slice(0,19));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "futureAppointment",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create test data",
      "item": [
        {
          "name": "Create Hospital",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Royal Hospital\",\n  \"location\": \"Muscat\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/hospitals"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) { const j=pm.response.json(); if (j.id) pm.environment.set(\"hospitalId\", j.id); }"
                ]
              }
            }
          ]
        },
